# --- Safety (defaults are conservative) ---
LIVE_TRADING=false
READ_ONLY=true
ENABLE_ORDERS=false
PAPER=true

# --- Interactive Brokers (TWS / Gateway) ---
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=7
IB_ACCOUNT=

# --- Strategy ---
UNDERLYING=SPY
CREDIT_SIDE=put
MIN_MINUTES_AFTER_OPEN=30
MIN_CREDIT=0.15
SPREAD_WIDTH=1.0
MAX_CONTRACTS=1
MAX_DAILY_LOSS=500
ENTRY_CUTOFF=15:00
FLATTEN_TIME=15:45
POLL_INTERVAL_SEC=30
MAX_NET_CALL_RISK=50000
STRONG_BULLISH_SKEW=0.55

# --- Providers (comma-separated) ---
PROVIDERS_ENABLED=ibkr,unusual_whales,alpaca

# --- Unusual Whales ---
UNUSUAL_WHALES_API_KEY=
UW_BASE_URL=https://api.unusualwhales.com
UW_MODE=alerts_only
UW_REQUIRED=false
UW_MIN_STRENGTH=0.35
UW_POLL_INTERVAL_SEC=120
UW_CACHE_TTL_SEC=90
UW_STALE_BLOCK_SEC=600

# --- Alpaca (read-only market data) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Coinbase macro overlay (public stats API) ---
# Enable by adding coinbase to PROVIDERS_ENABLED
COINBASE_PRODUCTS=BTC-USD,ETH-USD
COINBASE_RISK_OFF_THRESHOLD_PCT=3.0
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Optional stub providers (require ENABLE flag + API key) ---
ORATS_ENABLED=false
ORATS_API_KEY=
YOU_FINANCE_ENABLED=false
YOU_API_KEY=
CONTEXT_ENABLED=false
CONTEXT_API_KEY=
SP_GLOBAL_ENABLED=false
SP_GLOBAL_API_KEY=
DALOOPA_ENABLED=false
DALOOPA_API_KEY=
PERSPECTIVE_ENABLED=false
PERSPECTIVE_API_KEY=

CONFIG_YAML=
LOG_LEVEL=INFO

# --- Macro news ---
MACRO_ENABLED=true
MACRO_BLACKOUT_BEFORE_MIN=30
MACRO_BLACKOUT_AFTER_MIN=45
MACRO_HEADLINE_INTENSITY_BLOCK=0.75
MACRO_SIZE_SCALE=0.5

# --- Sharpe gate (live journal) ---
SHARPE_GATE_ENABLED=false
SHARPE_MIN=1.5
SHARPE_WINDOW_DAYS=60
SHARPE_MIN_OBS=60
JOURNAL_PATH=data/journal/daily_pnl.jsonl

# --- Backtest ---
BACKTEST_EQUITY_BASE=100000
BACKTEST_ROLLING_WINDOW_DAYS=60
BACKTEST_SHARPE_TARGET=1.5
BACKTEST_CACHE_DIR=data/cache
UW_BACKTEST_CACHE_DIR=data/cache/uw
# Session without UW cache: neutral | skip | block
UW_BACKTEST_MODE=neutral
# permissive | strict (strict leaves out sessions without headline data)
MACRO_BACKTEST_MODE=permissive
PROVIDERS_BACKTEST_ENABLED=alpaca,unusual_whales,macro_news
BACKTEST_SLIPPAGE_TICKS=1
BACKTEST_COMMISSION_PER_CONTRACT=0.65
BACKTEST_DECISION_INTERVAL_MIN=5
BACKTEST_WALK_FORWARD_TRAIN_DAYS=60
BACKTEST_WALK_FORWARD_TEST_DAYS=20
BACKTEST_REQUIRE_SHARPE_PASS=false
# 0 = no stop; 2.0 stops a spread at twice its entry credit
STOP_LOSS_CREDIT_MULTIPLE=0

# --- Improvement loop ---
IMPROVEMENT_AUTO_PROMOTE_PAPER=true
IMPROVEMENT_AUTO_PROMOTE_LIVE=false
PARAMS_ACTIVE_PATH=params/active.yaml
PARAMS_HISTORY_DIR=params/history