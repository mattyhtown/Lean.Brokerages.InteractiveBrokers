# --- Safety (defaults are conservative) ---
LIVE_TRADING=false
READ_ONLY=true
ENABLE_ORDERS=false
PAPER=true

# --- Interactive Brokers (TWS / Gateway) ---
IB_HOST=127.0.0.1
IB_PORT=7497
IB_CLIENT_ID=7
IB_ACCOUNT=

# --- Strategy ---
UNDERLYING=SPY
CREDIT_SIDE=put
MIN_MINUTES_AFTER_OPEN=30
MIN_CREDIT=0.15
SPREAD_WIDTH=1.0
MAX_CONTRACTS=1
MAX_DAILY_LOSS=500
ENTRY_CUTOFF=15:00
FLATTEN_TIME=15:45
POLL_INTERVAL_SEC=30

# --- Providers (comma-separated) ---
PROVIDERS_ENABLED=ibkr,unusual_whales,alpaca

# --- Unusual Whales ---
UNUSUAL_WHALES_API_KEY=
UW_BASE_URL=https://api.unusualwhales.com
UW_MODE=alerts_only
UW_REQUIRED=false
UW_MIN_STRENGTH=0.35
UW_POLL_INTERVAL_SEC=120
UW_CACHE_TTL_SEC=90
UW_STALE_BLOCK_SEC=600

# --- Alpaca (read-only market data) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_URL=https://data.alpaca.markets

# --- Coinbase macro overlay (public stats API) ---
# Enable by adding coinbase to PROVIDERS_ENABLED
COINBASE_PRODUCTS=BTC-USD,ETH-USD
COINBASE_RISK_OFF_THRESHOLD_PCT=3.0
COINBASE_API_KEY=
COINBASE_API_SECRET=

# --- Optional stub providers (require ENABLE flag + API key) ---
ORATS_ENABLED=false
ORATS_API_KEY=
YOU_FINANCE_ENABLED=false
YOU_API_KEY=
CONTEXT_ENABLED=false
CONTEXT_API_KEY=
SP_GLOBAL_ENABLED=false
SP_GLOBAL_API_KEY=
DALOOPA_ENABLED=false
DALOOPA_API_KEY=
PERSPECTIVE_ENABLED=false
PERSPECTIVE_API_KEY=

CONFIG_YAML=
LOG_LEVEL=INFO