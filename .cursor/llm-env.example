# LLM Provider & MCP Environment Template
# Copy needed variables to ~/.mcp-env (chmod 600), your secret manager, or client MCP env.
# NEVER commit real API keys, tokens, or connection strings.
#
# Full provider registry: cd multi-llm && poetry run multi-llm providers

# --- Frontier APIs ---
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIza...
# GOOGLE_API_KEY=AIza...
# XAI_API_KEY=xai-...
# COHERE_API_KEY=...

# --- US / Global inference & aggregators ---
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=sk-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=fw_...
# PERPLEXITY_API_KEY=pplx-...
# CEREBRAS_API_KEY=csk-...
# OPENROUTER_API_KEY=sk-or-v1-...
# HF_TOKEN=hf_...            # also used by the finbert sentiment provider
# HUGGINGFACE_API_KEY=hf_...
# NVIDIA_API_KEY=...
# SAMBANOVA_API_KEY=...
# DEEPINFRA_API_KEY=...
# ANYSCALE_API_KEY=...
# LAMBDA_API_KEY=...
# FRIENDLI_API_KEY=...
# NEBIUS_API_KEY=...
# HYPERBOLIC_API_KEY=...
# NOVITA_API_KEY=...
# WRITER_API_KEY=...
# REKA_API_KEY=...
# AI21_API_KEY=...

# --- Asia-Pacific APIs ---
# MOONSHOT_API_KEY=...
# DASHSCOPE_API_KEY=...
# ZHIPU_API_KEY=...
# MINIMAX_API_KEY=...
# YI_API_KEY=...
# BAICHUAN_API_KEY=...
# SILICONFLOW_API_KEY=...
# TENCENT_HUNYUAN_API_KEY=...

# --- Enterprise cloud ---
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1
# AWS_REGION=us-east-1
# AWS_BEARER_TOKEN_BEDROCK=...
# WATSONX_API_KEY=...
# WATSONX_URL=https://us-south.ml.cloud.ibm.com/ml/v1
# GOOGLE_CLOUD_ACCESS_TOKEN=...   # short-lived OAuth token (not a service-account JSON path)
# VERTEX_OPENAI_BASE_URL=https://REGION-aiplatform.googleapis.com/v1/projects/PROJECT/locations/REGION/endpoints/ENDPOINT
# DATABRICKS_TOKEN=dapi...
# DATABRICKS_BASE_URL=https://YOUR-WORKSPACE.cloud.databricks.com/serving-endpoints
# SNOWFLAKE_TOKEN=...
# SNOWFLAKE_CORTEX_BASE_URL=https://ACCOUNT.snowflakecomputing.com/api/v2/cortex/openai/v1

# --- Gateways & hosted inference ---
# VERCEL_AI_GATEWAY_API_KEY=...
# AI_GATEWAY_API_KEY=...
# VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
# BASETEN_API_KEY=...
# BASETEN_BASE_URL=https://model-XXXX.api.baseten.co/v1
# LEPTON_API_KEY=...
# LEPTON_BASE_URL=https://YOUR-WORKSPACE.lepton.run/api/v1

# --- Local / any OpenAI-compatible server ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_COMPATIBLE_API_KEY=local

# --- MCP Server Credentials (Supabase OAuth in interactive clients) ---
# SUPABASE_ACCESS_TOKEN=sbp_...
# UW_API_KEY=...
# MDB_MCP_CONNECTION_STRING=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/
# MDB_MCP_API_CLIENT_ID=...
# MDB_MCP_API_CLIENT_SECRET=...
# MDB_MCP_READ_ONLY=true