{
  "mcpServers": {
    "supabase": {
      "httpUrl": "https://mcp.supabase.com/mcp"
    },
    "unusualwhales": {
      "httpUrl": "https://api.unusualwhales.com/api/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_UW_API_KEY"
      }
    },
    "mongodb": {
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@3.3.0"],
      "env": {
        "MDB_MCP_API_CLIENT_ID": "YOUR_ATLAS_CLIENT_ID",
        "MDB_MCP_API_CLIENT_SECRET": "YOUR_ATLAS_CLIENT_SECRET",
        "MDB_MCP_READ_ONLY": "true"
      }
    },
    "databento": {
      "command": "dbn-go-mcp-meta",
      "args": [],
      "env": {
        "DATABENTO_API_KEY": "YOUR_DATABENTO_API_KEY"
      }
    },
    "thetadata": {
      "url": "http://127.0.0.1:25503/mcp/sse",
      "timeout": 30000
    }
  }
}
