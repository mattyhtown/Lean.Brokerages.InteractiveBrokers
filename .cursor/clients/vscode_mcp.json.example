{
  "inputs": [
    {
      "type": "promptString",
      "id": "uw-api-key",
      "description": "Unusual Whales API Key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mdb-client-id",
      "description": "MongoDB Atlas API Client ID",
      "password": false
    },
    {
      "type": "promptString",
      "id": "mdb-client-secret",
      "description": "MongoDB Atlas API Client Secret",
      "password": true
    },
    {
      "type": "promptString",
      "id": "databento-api-key",
      "description": "Databento API Key",
      "password": true
    }
  ],
  "servers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "unusualwhales": {
      "type": "http",
      "url": "https://api.unusualwhales.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${input:uw-api-key}"
      }
    },
    "mongodb": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@3.3.0"],
      "env": {
        "MDB_MCP_API_CLIENT_ID": "${input:mdb-client-id}",
        "MDB_MCP_API_CLIENT_SECRET": "${input:mdb-client-secret}",
        "MDB_MCP_READ_ONLY": "true"
      }
    },
    "databento": {
      "type": "stdio",
      "command": "dbn-go-mcp-meta",
      "args": [],
      "env": {
        "DATABENTO_API_KEY": "${input:databento-api-key}"
      }
    },
    "thetadata": {
      "type": "sse",
      "url": "http://127.0.0.1:25503/mcp/sse"
    }
  }
}
