{
  "inputs": [
    {
      "type": "promptString",
      "id": "uw-api-key",
      "description": "Unusual Whales API Key",
      "password": true
    },
    {
      "type": "promptString",
      "id": "mdb-client-id",
      "description": "MongoDB Atlas API Client ID",
      "password": false
    },
    {
      "type": "promptString",
      "id": "mdb-client-secret",
      "description": "MongoDB Atlas API Client Secret",
      "password": true
    }
  ],
  "servers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    "unusualwhales": {
      "type": "http",
      "url": "https://api.unusualwhales.com/api/mcp",
      "headers": {
        "Authorization": "Bearer ${input:uw-api-key}"
      }
    },
    "mongodb": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mongodb-mcp-server@latest"],
      "env": {
        "MDB_MCP_API_CLIENT_ID": "${input:mdb-client-id}",
        "MDB_MCP_API_CLIENT_SECRET": "${input:mdb-client-secret}",
        "MDB_MCP_READ_ONLY": "true"
      }
    }
  }
}
